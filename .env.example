# kb 环境变量模板：只放键名与空值。真实值写入本机 .env（已 .gitignore），勿入库。
# 所有键以 KB_ 开头，可通过 OS 环境变量或在 .env 中配置。

# 运行数据根目录（ChromaDB、runtime.json 等落于此）
KB_DATA_DIR=

# 设备：空=自动检测；显式设 cpu 或 cuda 覆盖自动检测
KB_DEVICE=

# Embedding 模型（默认 BAAI/bge-m3；测试/轻量可换 BAAI/bge-small-zh-v1.5）
KB_EMBED_MODEL=

# LLM 模式：local | auto | cloud
KB_LLM_MODE=

# Ollama 兼容端点
KB_OLLAMA_BASE_URL=

# 本地模型名（以 `ollama list` 为准）
KB_LLM_MODEL=

# DeepSeek 云端降级（可选）：Base URL / 模型名
KB_DEEPSEEK_API_KEY=
KB_DEEPSEEK_BASE_URL=
KB_DEEPSEEK_MODEL=

# 文档切分参数
KB_CHUNK_SIZE=
KB_CHUNK_OVERLAP=

# 目录监听目录
KB_WATCH_DIR=

# REST API 监听
KB_API_HOST=
KB_API_PORT=

# API Key 鉴权（N19）：空=不鉴权（本地回环零摩擦）；非空=启用 Bearer/X-API-Key 鉴权
KB_API_KEY=

# /ask 检索上下文 token 硬上限
KB_CONTEXT_TOKEN_LIMIT=

# LLM 输出 / 温控护栏
KB_LLM_MAX_TOKENS=
KB_LLM_TEMPERATURE=

# /ask 答案缓存：条数（LRU）与命中相似度阈值
KB_CACHE_SIZE=
KB_CACHE_SIM_THRESHOLD=

# 敏感 namespace（逗号分隔），命中强制本地、数据不出网
KB_SENSITIVE_NAMESPACES=

# 监控 Agent（N18）：常驻线程默认关（按需端点/看板按钮触发）
KB_MONITOR_ENABLED=
KB_MONITOR_INTERVAL=
KB_MONITOR_STARTUP_RUN=
KB_MONITOR_MAX_TOKENS=
KB_MONITOR_AUTOTIMER=
# 异常调度（comm:dispatch）：监控单轮后异常播报，默认开
KB_DISPATCH_ENABLED=
# 监控摘要模式（TASK-0065）：off=全程纯文本不调LLM(默认零成本/不抢GPU) / auto=LLM可用摘要化不可用降级
KB_MONITOR_LLM=
# 记忆治理 A3（N21b 衰减，TASK-0068）：访问频率衰减，仅影响 hybrid/vector 检索排序，默认关（零行为变化）
# 开关：true=启用；长期未访问降权、高频访问加权（看 last_accessed/access_count）
KB_DECAY_ENABLED=
# 衰减速率 λ（/天），默认 0.02（半衰期≈35 天）
KB_DECAY_LAMBDA=
# 高频访问加权系数 γ，默认 0.3（access_count=10 → 约 2.0 倍）
KB_DECAY_GAMMA=
# 记忆治理 A3（N22b 新鲜度权重，TASK-0070）：内容新旧加权（看 updated_at），仅影响 hybrid/vector 排序，默认关（零行为变化）
# 开关：true=启用；刚更新的记录最高加权 1+α 倍，与衰减正交相乘
KB_FRESHNESS_ENABLED=
# 新鲜度衰减速率 β（/天），默认 0.05（半衰期≈14 天）
KB_FRESHNESS_BETA=
# 新鲜度加权上限系数 α，默认 0.3（boost 范围 [1, 1.3]）
KB_FRESHNESS_ALPHA=
# 记忆治理审计（N23b/TASK-0073）：治理操作结构化审计日志，去重默认开/衰减新鲜度默认关
KB_AUDIT_DEDUP_ENABLED=
KB_AUDIT_DECAY_ENABLED=
KB_AUDIT_FRESHNESS_ENABLED=
# 记忆治理 A3（N22a 语义去重，TASK-0069）：写入前向量检索 top1 判重，默认关（零行为变化）
# 开关：true=启用；命中重复时 POST /memories 返回 409（含 duplicate_of）不写入；检查异常降级不阻塞写入
KB_DEDUP_ENABLED=
# 去重余弦相似度阈值，默认 0.92（≥此值视为重复；BGE-M3 下 0.92 以上高度重复）
KB_DEDUP_THRESHOLD=
# A3 智能层 consolidation（N23c 基础框架，TASK-0076）：LLM 记忆归并，默认关（零行为变化）
KB_CONSOLIDATION_ENABLED=
KB_CONSOLIDATION_CONFIDENCE_THRESHOLD=
# A3.5 检索质量（N24 交叉重排，2026-08-28）：融合候选送 bge-reranker-v2-m3 精排，默认关（零行为变化）
KB_RERANK_ENABLED=
KB_RERANK_MODEL=
KB_RERANK_TOP_N=
# A3.5 检索质量（N25 稀疏第三路）：BGE-M3 sparse 头 + 倒排索引，三路 RRF 融合，默认关（失败自动降级双路）
KB_SPARSE_ENABLED=
