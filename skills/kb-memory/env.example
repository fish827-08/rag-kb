# kb configuration template (copy to the repo root as ".env").
# Only key names and empty values belong here. Never commit real secrets.

# Data directory (ChromaDB store, runtime state). Default: ./kb_data
KB_DATA_DIR=

# Device: empty = auto-detect; "cpu" or "cuda" to override.
KB_DEVICE=

# Embedding model. Default: BAAI/bge-small-zh-v1.5 (~92 MB, 512-dim).
# Optional stronger model: BAAI/bge-m3 (~2.2 GB, 1024-dim).
# Existing databases keep the model they were built with (kb_data/runtime.json).
KB_EMBED_MODEL=

# HTTP / MCP listen address. Defaults: 127.0.0.1:8000.
KB_API_HOST=
KB_API_PORT=

# API key auth. Empty = no auth (localhost only). Non-empty = Bearer / X-API-Key.
KB_API_KEY=

# LLM mode for /ask: off (default) | local | auto | cloud.
# Memory write/search works without any LLM.
KB_LLM_MODE=

# Local Ollama (for KB_LLM_MODE=local|auto).
KB_OLLAMA_BASE_URL=
KB_LLM_MODEL=

# Any OpenAI-compatible provider (for KB_LLM_MODE=auto|cloud).
KB_LLM_API_KEY=
KB_LLM_BASE_URL=
KB_LLM_CLOUD_MODEL=

# Directory watch (auto-ingest new files). Empty or "." disables watching.
KB_WATCH_DIR=

# Optional retrieval enhancements (default off).
KB_RERANK_ENABLED=
KB_SPARSE_ENABLED=
